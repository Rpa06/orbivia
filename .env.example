# Valores solo para desarrollo local. Cámbialos antes de exponer el despliegue.
POSTGRES_DB=orbivia
POSTGRES_USER=orbivia
POSTGRES_PASSWORD=cambia-esta-clave-local
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=8000
FRONTEND_PORT=8080

# --- Datos de sueño (servicios worker-stream y api). Todas opcionales; ver
# procesamiento/streaming-valores-continuos-sueno/README.md
# Tamaño de las ventanas de agregación (s) y cuánto se conserva cada nivel antes de
# fundirlo en el siguiente (un valor menos; el último nivel dura toda la sesión)
# SLEEP_LEVELS_S=60,300,900,1800
# SLEEP_RETAIN_S=900,3600,7200
# Anomalías estadísticas: umbral en desviaciones típicas y semivida de la referencia
# SLEEP_Z_THRESHOLD=4.0
# SLEEP_EWMA_HALFLIFE_S=600
# Un minuto cuenta como activo si la media de movimiento supera este valor
# SLEEP_ACTIVITY_THRESHOLD=0.3
# Epoch Unix del segundo 0 de la misión (para las mediciones del planificador)
# SLEEP_MISSION_EPOCH_S=0
# Caducidad del estado temporal en Redis tras guardar el resumen en PostgreSQL
# SLEEP_COMPLETED_TTL_S=172800

# --- Grafo social (servicio social-graph). Todas opcionales; ver procesamiento/grafos/README.md
# Fuente de datos: simulation (demo) o redis (stream orbivia:positions)
SG_SOURCE=simulation
# Escenario simulado: homogeneous, low_integration, cliques, drift, unequal_leisure,
# shifted_schedules, schedule_change, simultaneous, sensor_loss, crew_wide_drop
SG_SIM_SCENARIO=drift
# Segundos simulados por segundo real (3600 = un día de misión cada 24 s)
SG_SIM_SPEEDUP=3600
# Frecuencia de muestreo de posiciones, en segundos
SG_SIM_SAMPLE_PERIOD_S=10
SG_SIM_SEED=42
# Días de misión a simular antes de quedar en pausa (0 = sin límite)
SG_SIM_DAYS=60
# Modelo
SG_D_IN_M=2.0
SG_D_OUT_M=2.5
SG_MIN_DWELL_S=60
SG_MAX_GAP_S=60
SG_DAY_CUTOFF=04:00
SG_KAPPA=0.3

# --- Planificador de tareas (servicio planner). Todas opcionales; ver sistema-de-recomendacion/planificador/README.md
# Cualquier valor de config/default.toml: CP_<SECCIÓN>_<CLAVE>
# CP_WEIGHTS_GAMMA=0.3
# CP_WEIGHTS_MU=0.2
# CP_STAGES_MODE=lexicographic
